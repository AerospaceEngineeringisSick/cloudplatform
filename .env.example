# ============================================================================
#  Personal cloud platform — configuration
#
#  Copy to .env and fill in. scripts/bootstrap.sh does this for you and
#  generates SESSION_SECRET on first run.
# ============================================================================

# ---------------------------------------------------------------- identity --

# The domain the services are published under. You need DNS records for
# media, cloud, panel and host pointing at this VPS.
DOMAIN=example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

TZ=Europe/London

# ---------------------------------------------------------------- security --

# Signs session cookies. Must be long, random and STABLE — changing it signs
# everyone out. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me

# The dashboard's own origin. WebAuthn passkeys are bound to this exactly,
# so it must match what the browser shows, including https://.
DASHBOARD_ORIGIN=https://panel.example.com
WEBAUTHN_RP_ID=panel.example.com
WEBAUTHN_RP_NAME=Cloud Platform

# Addresses allowed to reach the admin surfaces. The default is Tailscale's
# range; use your WireGuard subnet if you run your own.
TAILSCALE_CIDR=100.64.0.0/10

# ----------------------------------------------------------------- storage --

# Tier 1: the mounted 1 TB local disk.
HDD_PATH=/mnt/hdd

# Tier 2: the rclone SFTP mount of the 2 TB StorageBox.
STORAGEBOX_PATH=/mnt/storagebox

# Tier 0 scratch: transcoding is write-heavy, so it stays on NVMe.
NVME_CACHE=/var/cache/jellyfin

# The live Minecraft world, also on NVMe.
MINECRAFT_PATH=/srv/minecraft

# rclone
RCLONE_REMOTE=storagebox
RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
RCLONE_CACHE_DIR=/var/cache/rclone
RCLONE_CACHE_SIZE=20G
RCLONE_TRANSFERS=4
# Leave empty for unlimited, or e.g. "40M" to keep headroom for streaming.
RCLONE_BWLIMIT=

# ----------------------------------------------------------------- network --

# The interface the transfer counter watches. Check with: ip -br link
NET_IFACE=eth0

# 80 TB monthly allowance, in bytes.
NET_ALLOWANCE_BYTES=87960930222080
NET_LINK_MBPS=10000

# ---------------------------------------------------------------- services --

# Jellyfin. Create the API key under Dashboard → API Keys once it is running.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Minecraft RCON. Required for players, TPS and the console.
# Generate with: openssl rand -hex 24
MC_RCON_HOST=minecraft
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
MC_VERSION=1.21.4
MC_MEMORY=6G
MC_MAX_PLAYERS=12

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_PASSWORD=

# Browser desktop
DESKTOP_USER=luke
DESKTOP_PASSWORD=

# File ownership for the media and desktop containers. Check with: id -u; id -g
PUID=1000
PGID=1000

# ------------------------------------------------------------------- misc --

LOG_LEVEL=info
