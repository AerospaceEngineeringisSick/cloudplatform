# Default: certificates are issued over the HTTP-01 challenge.
#
# This requires ports 80 and 443 to be reachable from the internet for every
# hostname — including panel and host, whose 403 is applied only after the
# certificate exists.
#
# If you would rather not expose port 80 at all, or would rather panel and host
# did not appear in public DNS, switch to the DNS-01 variant:
#
#   CADDYFILE=Caddyfile.dns  in .env, plus a Cloudflare API token
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

import /etc/caddy/sites.caddy
